DATABASE_URL="database_url"
PORT=3000
APP_BASE_URL="http://localhost:3000"
LOG_LEVEL=info
LOG_PRETTY=true
GITHUB_TOKEN=""
SCAN_INTERVAL_MS=60000
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your.email@gmail.com"
SMTP_PASS="your-16-char-gmail-app-password"
